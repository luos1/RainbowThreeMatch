rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validSave() {
        return request.resource.data.keys().hasAll(['highScore', 'updatedAt', 'displayName'])
          && request.resource.data.keys().hasOnly(['highScore', 'updatedAt', 'displayName'])
          && request.resource.data.highScore is int
          && request.resource.data.highScore >= 0
          && request.resource.data.highScore <= 2147483647
          && request.resource.data.updatedAt is int
          && request.resource.data.updatedAt >= 0
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 80;
      }
      allow read: if owner();
      allow create: if owner() && validSave();
      allow update: if owner() && validSave()
        && request.resource.data.highScore >= resource.data.highScore
        && request.resource.data.updatedAt >= resource.data.updatedAt;
      allow delete: if false;
    }
  }
}
